# Copy to backend/.env and fill in. Every value has a working default except the API keys.

# Database (docker compose exposes Postgres on host port 5434)
DATABASE_URL=postgresql+psycopg://cnc:cnc@localhost:5434/cnc

# LLM providers. Without keys, set LLM_PRIMARY_PROVIDER=fake to run the deterministic demo adapter.
ANTHROPIC_API_KEY=
# Alternative to ANTHROPIC_API_KEY: an OAuth bearer token. Subscription tokens (sk-ant-oat01-...)
# issued for Claude Code are rejected for API use; use a Console API key (sk-ant-api03-...).
ANTHROPIC_AUTH_TOKEN=
GROQ_API_KEY=

# Internal testing only: Claude through the official Claude Code CLI on your own subscription.
# Create the token with `claude setup-token`, set LLM_PRIMARY_PROVIDER=claude_code, and have the
# `claude` CLI installed locally (it is not in the Docker image). Production uses ANTHROPIC_API_KEY.
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_CODE_MODEL=claude-opus-5-5
# CLAUDE_CODE_BIN=   # path to the native claude executable; auto-detected when unset

LLM_PRIMARY_PROVIDER=anthropic
LLM_FALLBACK_PROVIDER=groq
ANTHROPIC_MODEL=claude-opus-5-5
GROQ_MODEL=openai/gpt-oss-120b
LLM_EFFORT=medium

# Misc
LOG_FORMAT=console
CORS_ORIGINS=["http://localhost:3000"]
# AUTO_INGEST=true ingests DATA_DIR (default: ../data) at startup
AUTO_INGEST=false
